@{
    Layout = null;

    Guid? selectedConversationId =
        ViewBag.ConversationId is Guid id
            ? id
            : null;
}

<!DOCTYPE html>
<html lang="tr" data-theme="light">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>NexaAI</title>

    <script>
        try {
            const savedTheme = localStorage.getItem("nexa-theme");

            document.documentElement.dataset.theme =
                savedTheme === "dark"
                    ? "dark"
                    : "light";
        } catch (_) {
        }
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"/>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

    <style>
        :root {
            --bg: #f4f4f2;
            --surface: #ffffff;
            --surface-soft: #f3f3f0;
            --surface-hover: #ebebe7;

            --text: #111111;
            --text-soft: #777777;
            --text-muted: #a0a0a0;

            --border: #111111;
            --soft-border: #dfdfda;

            --primary: #111111;
            --primary-text: #ffffff;

            --danger: #d94c4c;
            --shadow: rgba(0, 0, 0, .07);
        }

        html[data-theme="dark"] {
            --bg: #0d0d0d;
            --surface: #151515;
            --surface-soft: #202020;
            --surface-hover: #292929;

            --text: #f5f5f5;
            --text-soft: #a5a5a5;
            --text-muted: #707070;

            --border: #e5e5e5;
            --soft-border: #303030;

            --primary: #f4f4f4;
            --primary-text: #111111;

            --danger: #ef6868;
            --shadow: rgba(0, 0, 0, .35);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        body {
            background: var(--bg);
            color: var(--text);

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        .app {
            width: calc(100vw - 60px);
            height: calc(100vh - 60px);

            margin: 30px;

            display: grid;
            grid-template-columns: 280px minmax(0, 1fr);

            background: var(--surface);

            border: 2px solid var(--border);

            overflow: hidden;
        }

        .sidebar {
            min-width: 0;
            min-height: 0;

            display: flex;
            flex-direction: column;

            border-right: 2px solid var(--border);

            overflow: hidden;
        }

        .sidebar-header {
            height: 64px;
            flex-shrink: 0;

            display: flex;
            align-items: center;

            padding: 0 20px;

            border-bottom: 2px solid var(--border);
        }

        .brand {
            font-size: 20px;
            font-weight: 750;
            letter-spacing: -1px;
        }

        .brand span {
            color: var(--text-soft);
            font-weight: 400;
        }

        .sidebar-content {
            flex: 1;

            min-height: 0;

            padding: 17px;

            overflow-y: auto;
            overflow-x: hidden;
        }

        .new-chat {
            width: 100%;
            height: 44px;

            border: 0;
            border-radius: 9px;

            background: var(--primary);
            color: var(--primary-text);

            font-size: 13px;
            font-weight: 600;

            transition: .15s ease;
        }

        .new-chat:hover {
            opacity: .86;
            transform: translateY(-1px);
        }

        .new-chat-panel {
            display: none;

            margin-top: 10px;
            padding: 12px;

            border: 1px solid var(--soft-border);
            border-radius: 9px;

            background: var(--surface-soft);
        }

        .new-chat-panel.show {
            display: block;
        }

        .new-chat-label {
            display: block;

            margin-bottom: 7px;

            color: var(--text-soft);

            font-size: 11px;
            font-weight: 600;
        }

        .new-chat-input {
            width: 100%;
            height: 40px;

            padding: 0 11px;

            border: 1px solid var(--soft-border);
            border-radius: 7px;

            outline: none;

            background: var(--surface);
            color: var(--text);

            font-size: 12px;
        }

        .new-chat-input::placeholder {
            color: var(--text-muted);
        }

        .new-chat-input:focus {
            border-color: var(--border);
        }

        .new-chat-actions {
            display: flex;
            justify-content: flex-end;

            gap: 6px;

            margin-top: 9px;
        }

        .new-chat-cancel,
        .new-chat-create {
            height: 32px;

            padding: 0 11px;

            border: 0;
            border-radius: 7px;

            font-size: 11px;
            font-weight: 600;
        }

        .new-chat-cancel {
            background: transparent;
            color: var(--text-soft);
        }

        .new-chat-cancel:hover {
            background: var(--surface-hover);
            color: var(--text);
        }

        .new-chat-create {
            background: var(--primary);
            color: var(--primary-text);
        }

        .conversation-error {
            margin-top: 10px;
            padding: 9px 10px;

            border: 1px solid rgba(217, 76, 76, .35);
            border-radius: 7px;

            color: var(--danger);

            font-size: 10px;
        }

        .sidebar-label {
            margin-top: 27px;
            margin-bottom: 9px;

            color: var(--text-muted);

            font-size: 10px;
            font-weight: 700;

            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

        .conversation {
            width: 100%;

            display: block;

            padding: 10px 11px;
            margin-bottom: 3px;

            border: 0;
            border-radius: 8px;

            background: transparent;
            color: var(--text-soft);

            text-align: left;
            text-decoration: none;

            font-size: 13px;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;

            transition: .15s ease;
        }

        .conversation:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .conversation.active {
            background: var(--surface-hover);
            color: var(--text);

            font-weight: 550;
        }

        .sidebar-footer {
            min-height: 66px;
            flex-shrink: 0;

            padding: 10px 13px;

            border-top: 1px solid var(--soft-border);

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-user {
            display: flex;
            align-items: center;

            gap: 10px;

            min-width: 0;
        }

        .small-avatar {
            width: 34px;
            height: 34px;

            flex-shrink: 0;

            border-radius: 50%;

            background: var(--primary);
            color: var(--primary-text);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 11px;
            font-weight: 700;
        }

        .user-text {
            min-width: 0;
        }

        .user-name {
            font-size: 12px;
            font-weight: 650;
        }

        .user-mail {
            color: var(--text-muted);

            font-size: 10px;
        }

        .logout-icon {
            width: 34px;
            height: 34px;

            border: 0;
            border-radius: 8px;

            background: transparent;
            color: var(--text-soft);

            display: flex;
            align-items: center;
            justify-content: center;

            transition: .15s;
        }

        .logout-icon:hover {
            color: var(--danger);
            background: var(--surface-soft);
        }

        .content {
            min-width: 0;
            min-height: 0;

            display: grid;
            grid-template-rows: 64px minmax(0, 1fr);

            overflow: hidden;
        }

        .topbar {
            position: relative;

            height: 64px;

            border-bottom: 2px solid var(--border);

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 18px 0 22px;
        }

        .assistant-select {
            position: relative;
        }

        .assistant-button {
            padding: 8px 9px;

            border: 0;
            border-radius: 7px;

            background: transparent;
            color: var(--text);

            font-size: 13px;
            font-weight: 500;
        }

        .assistant-button:hover {
            background: var(--surface-soft);
        }

        .assistant-menu {
            position: absolute;

            top: 44px;
            left: 0;

            width: 200px;

            padding: 6px;

            background: var(--surface);

            border: 1px solid var(--soft-border);
            border-radius: 11px;

            box-shadow: 0 15px 40px var(--shadow);

            display: none;

            z-index: 50;
        }

        .assistant-menu.show {
            display: block;
        }

        .assistant-menu button {
            width: 100%;

            padding: 9px 10px;

            border: 0;
            border-radius: 7px;

            background: transparent;
            color: var(--text);

            text-align: left;

            font-size: 12px;
        }

        .assistant-menu button:hover {
            background: var(--surface-soft);
        }

        .topbar-right {
            display: flex;
            align-items: center;

            gap: 7px;
        }

        .top-icon {
            width: 38px;
            height: 38px;

            border: 0;
            border-radius: 50%;

            background: transparent;
            color: var(--text);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 17px;
        }

        .top-icon:hover {
            background: var(--surface-soft);
        }

        .profile-wrapper {
            position: relative;
        }

        .profile-button {
            width: 40px;
            height: 40px;

            border: 2px solid var(--border);
            border-radius: 50%;

            background: var(--surface);
            color: var(--text);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;
            font-weight: 700;
        }

        .profile-button:hover {
            background: var(--surface-soft);
        }

        .profile-menu {
            position: absolute;

            right: 0;
            top: 48px;

            width: 230px;

            padding: 7px;

            background: var(--surface);

            border: 1px solid var(--soft-border);
            border-radius: 12px;

            box-shadow: 0 16px 45px var(--shadow);

            display: none;

            z-index: 100;
        }

        .profile-menu.show {
            display: block;
        }

        .profile-menu-header {
            padding: 10px 11px 12px;

            border-bottom: 1px solid var(--soft-border);

            margin-bottom: 5px;
        }

        .profile-menu-name {
            font-size: 13px;
            font-weight: 650;
        }

        .profile-menu-mail {
            margin-top: 2px;

            color: var(--text-muted);

            font-size: 11px;
        }

        .profile-menu-item {
            width: 100%;

            padding: 9px 10px;

            border: 0;
            border-radius: 8px;

            background: transparent;
            color: var(--text);

            display: flex;
            align-items: center;

            gap: 9px;

            font-size: 12px;
            text-align: left;

            text-decoration: none;
        }

        .profile-menu-item:hover {
            background: var(--surface-soft);
        }

        .profile-menu-item.logout {
            color: var(--danger);
        }

        .main-area {
            position: relative;

            min-width: 0;
            min-height: 0;

            overflow: hidden;
        }

        .default-home {
            width: 100%;
            height: 100%;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 40px;
        }

        .default-home-inner {
            width: 100%;
            max-width: 650px;
        }

        .home-icon {
            width: 44px;
            height: 44px;

            margin-bottom: 22px;

            border-radius: 11px;

            background: var(--primary);
            color: var(--primary-text);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 18px;
        }

        .default-home h1 {
            margin: 0;

            font-size: clamp(42px, 4vw, 58px);
            font-weight: 650;

            line-height: 1;
            letter-spacing: -3px;
        }

        .default-home p {
            max-width: 520px;

            margin-top: 18px;
            margin-bottom: 0;

            color: var(--text-soft);

            font-size: 14px;
            line-height: 1.7;
        }

        .conversation-view {
            width: 100%;
            height: 100%;

            display: flex;
            flex-direction: column;

            min-height: 0;
        }

        .conversation-heading {
            flex-shrink: 0;

            padding: 20px 32px 14px;

            border-bottom: 1px solid var(--soft-border);
        }

        .conversation-heading-label {
            margin-bottom: 4px;

            color: var(--text-muted);

            font-size: 9px;
            font-weight: 700;

            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .conversation-title {
            margin: 0;

            font-size: 18px;
            font-weight: 650;

            letter-spacing: -.5px;
        }

        .chat-content {
            flex: 1;

            min-height: 0;

            overflow-y: auto;
            overflow-x: hidden;

            padding: 30px 35px 145px;
        }

        .messages {
            width: 100%;
            max-width: 760px;

            margin: 0 auto;

            display: flex;
            flex-direction: column;

            gap: 20px;
        }

        .message {
            max-width: 80%;

            padding: 12px 15px;

            border-radius: 14px;

            font-size: 14px;
            line-height: 1.6;
        }

        .message.user {
            align-self: flex-end;

            background: var(--primary);
            color: var(--primary-text);
        }

        .message.ai {
            align-self: flex-start;

            background: var(--surface-soft);
            color: var(--text);
        }

        .empty-conversation {
            max-width: 760px;

            margin: 11vh auto 0;

            color: var(--text-muted);

            text-align: center;

            font-size: 12px;
        }

        .composer-area {
            position: absolute;

            bottom: 0;
            left: 0;
            right: 0;

            z-index: 20;

            padding: 28px 30px 22px;

            background: linear-gradient(
                to top,
                var(--surface) 72%,
                transparent
            );
        }

        .composer {
            width: 100%;
            max-width: 760px;

            min-height: 60px;

            margin: auto;

            padding: 8px 9px 8px 17px;

            border: 1.5px solid var(--border);
            border-radius: 16px;

            background: var(--surface);

            display: flex;
            align-items: flex-end;

            box-shadow: 0 10px 35px var(--shadow);
        }

        .composer textarea {
            flex: 1;

            min-height: 42px;
            max-height: 150px;

            padding: 10px 5px;

            border: 0;
            outline: 0;

            resize: none;

            overflow-y: auto;

            background: transparent;
            color: var(--text);

            font-size: 14px;
        }

        .composer textarea::placeholder {
            color: var(--text-muted);
        }

        .composer-buttons {
            display: flex;
            align-items: center;

            gap: 4px;
        }

        .composer-button {
            width: 40px;
            height: 40px;

            border: 0;
            border-radius: 10px;

            background: transparent;
            color: var(--text);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 17px;
        }

        .composer-button:hover {
            background: var(--surface-soft);
        }

        .send-button {
            background: var(--primary);
            color: var(--primary-text);
        }

        .send-button:hover {
            background: var(--primary);
            opacity: .82;
        }

        .composer-note {
            margin-top: 7px;

            color: var(--text-muted);

            text-align: center;

            font-size: 9px;
        }

        @@media (max-width: 850px) {
            .app {
                width: 100vw;
                height: 100vh;

                margin: 0;

                border: 0;

                grid-template-columns: 1fr;
            }

            .sidebar {
                display: none;
            }

            .default-home {
                padding: 25px;
            }

            .chat-content {
                padding-left: 20px;
                padding-right: 20px;
            }

            .composer-area {
                padding-left: 14px;
                padding-right: 14px;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <aside class="sidebar">

        <div class="sidebar-header">

            <div class="brand">
                Nexa<span>AI</span>
            </div>

        </div>

        <div class="sidebar-content">

            <form method="post"
                  asp-controller="Conversation"
                  asp-action="Create"
                  id="createConversationForm">

                @Html.AntiForgeryToken()

                <button type="button"
                        class="new-chat"
                        id="newChatButton">

                    <i class="bi bi-plus-lg me-2"></i>

                    Yeni sohbet

                </button>

                <div class="new-chat-panel"
                     id="newChatPanel">

                    <label class="new-chat-label"
                           for="conversationTitle">

                        Sohbet başlığı

                    </label>

                    <input type="text"
                           id="conversationTitle"
                           name="Title"
                           class="new-chat-input"
                           placeholder="Başlık ne olsun?"
                           maxlength="80"
                           autocomplete="off"
                           required/>

                    <div class="new-chat-actions">

                        <button type="button"
                                class="new-chat-cancel"
                                id="cancelChatButton">

                            Vazgeç

                        </button>

                        <button type="submit"
                                class="new-chat-create">

                            Oluştur

                        </button>

                    </div>

                </div>

            </form>

            @if (TempData["ConversationError"] != null)
            {
                <div class="conversation-error">
                    @TempData["ConversationError"]
                </div>
            }

            @await Component.InvokeAsync("_DefaultMessageListComponentPartial", new { selectedConversationId })

        </div>

        <div class="sidebar-footer">

            <div class="sidebar-user">

                <div class="small-avatar">
                    FT
                </div>

                <div class="user-text">

                    <div class="user-name">
                        Furkan Türker
                    </div>

                    <div class="user-mail">
                        furkan@nexa.ai
                    </div>

                </div>

            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="logout-icon"
                        title="Çıkış yap">

                    <i class="bi bi-box-arrow-right"></i>

                </button>

            </form>

        </div>

    </aside>

    <main class="content">

        <header class="topbar">

            <div class="assistant-select">

                <button type="button"
                        class="assistant-button"
                        id="assistantButton">

                    Nexa Assistant

                    <i class="bi bi-chevron-down ms-1"></i>

                </button>

                <div class="assistant-menu"
                     id="assistantMenu">

                    <button type="button">
                        <i class="bi bi-stars me-2"></i>
                        Nexa Assistant
                    </button>

                    <button type="button">
                        <i class="bi bi-code-slash me-2"></i>
                        Code Assistant
                    </button>

                    <button type="button">
                        <i class="bi bi-mic me-2"></i>
                        Voice Assistant
                    </button>

                </div>

            </div>

            <div class="topbar-right">

                <button type="button"
                        class="top-icon"
                        id="themeButton"
                        title="Tema değiştir">

                    <i class="bi bi-moon"
                       id="themeIcon"></i>

                </button>

                <div class="profile-wrapper">

                    <button type="button"
                            class="profile-button"
                            id="profileButton">

                        FT

                    </button>

                    <div class="profile-menu"
                         id="profileMenu">

                        <div class="profile-menu-header">

                            <div class="profile-menu-name">
                                Furkan Türker
                            </div>

                            <div class="profile-menu-mail">
                                furkan@nexa.ai
                            </div>

                        </div>

                        <button type="button"
                                class="profile-menu-item">

                            <i class="bi bi-person"></i>

                            Profil

                        </button>

                        <button type="button"
                                class="profile-menu-item">

                            <i class="bi bi-gear"></i>

                            Ayarlar

                        </button>

                        <button type="button"
                                class="profile-menu-item"
                                id="profileThemeButton">

                            <i class="bi bi-circle-half"></i>

                            Temayı değiştir

                        </button>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="profile-menu-item logout">

                                <i class="bi bi-box-arrow-right"></i>

                                Çıkış yap

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </header>

        <section class="main-area">

            @if (selectedConversationId == null)
            {
                <div class="default-home">

                    <div class="default-home-inner">

                        <div class="home-icon">

                            <i class="bi bi-stars"></i>

                        </div>

                        <h1>
                            NexaAI'ye<br/>
                            hoş geldin.
                        </h1>

                        <p>
                            Devam etmek için soldaki sohbetlerinden
                            birini seç veya yeni bir sohbet oluştur.
                        </p>

                    </div>

                </div>
            }
            else
            {
                @await Component.InvokeAsync("_ConversationDetailComponentPartial", new { conversationId = selectedConversationId.Value })
            }

        </section>

    </main>

</div>

<script>
    const html =
        document.documentElement;

    const themeButton =
        document.getElementById("themeButton");

    const themeIcon =
        document.getElementById("themeIcon");

    const profileThemeButton =
        document.getElementById("profileThemeButton");

    const profileButton =
        document.getElementById("profileButton");

    const profileMenu =
        document.getElementById("profileMenu");

    const assistantButton =
        document.getElementById("assistantButton");

    const assistantMenu =
        document.getElementById("assistantMenu");

    const newChatButton =
        document.getElementById("newChatButton");

    const newChatPanel =
        document.getElementById("newChatPanel");

    const cancelChatButton =
        document.getElementById("cancelChatButton");

    const conversationTitleInput =
        document.getElementById("conversationTitle");

    function updateThemeIcon() {

        const isDark =
            html.dataset.theme === "dark";

        themeIcon.className =
            isDark
                ? "bi bi-sun"
                : "bi bi-moon";
    }

    function toggleTheme() {

        const newTheme =
            html.dataset.theme === "dark"
                ? "light"
                : "dark";

        html.dataset.theme =
            newTheme;

        localStorage.setItem(
            "nexa-theme",
            newTheme
        );

        updateThemeIcon();
    }

    themeButton.addEventListener(
        "click",
        toggleTheme
    );

    profileThemeButton.addEventListener(
        "click",
        toggleTheme
    );

    updateThemeIcon();

    profileButton.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();

            profileMenu
                .classList
                .toggle("show");

            assistantMenu
                .classList
                .remove("show");
        }
    );

    assistantButton.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();

            assistantMenu
                .classList
                .toggle("show");

            profileMenu
                .classList
                .remove("show");
        }
    );

    document.addEventListener(
        "click",
        function () {

            profileMenu
                .classList
                .remove("show");

            assistantMenu
                .classList
                .remove("show");
        }
    );

    newChatButton.addEventListener(
        "click",
        function () {

            newChatPanel
                .classList
                .toggle("show");

            if (
                newChatPanel
                    .classList
                    .contains("show")
            ) {
                conversationTitleInput.focus();
            }
        }
    );

    cancelChatButton.addEventListener(
        "click",
        function () {

            newChatPanel
                .classList
                .remove("show");

            conversationTitleInput.value =
                "";
        }
    );
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>