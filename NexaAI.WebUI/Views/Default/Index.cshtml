@using System.Security.Claims

@{
    Layout = null;
    Guid? selectedConversationId = ViewBag.ConversationId is Guid id ? id : null;
    var accessToken = User.FindFirst("access_token")?.Value;

    var name = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var surname = User.FindFirst(ClaimTypes.Surname)?.Value ?? "";
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? "";

    var fullName = $"{name} {surname}".Trim();
    var initials = $"{(string.IsNullOrWhiteSpace(name) ? "" : name[0])}{(string.IsNullOrWhiteSpace(surname) ? "" : surname[0])}".ToUpper();
}

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>NexaAI</title>

    <link rel="icon" type="image/svg+xml" href="/images/nexa-icon.svg?v=2"/>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/default.css" asp-append-version="true"/>
</head>

<body data-signalr-token="@accessToken">

<div class="app">

    <aside class="sidebar">

        <div class="sidebar-header">
            <div class="brand">Nexa<span>AI</span></div>
        </div>

        <div class="sidebar-content">

            <form asp-controller="Default" asp-action="Index" method="get">
                <button type="submit" class="new-chat">
                    <i class="bi bi-plus-lg me-2"></i>
                    Yeni sohbet
                </button>
            </form>

            @if (TempData["ConversationError"] != null)
            {
                <div class="conversation-error">@TempData["ConversationError"]</div>
            }

            @await Component.InvokeAsync("_DefaultMessageListComponentPartial", new { selectedConversationId })

        </div>

        <div class="sidebar-footer">

            <div class="sidebar-user">

                <div class="small-avatar">@initials</div>

                <div class="user-text">
                    <div class="user-name">@fullName</div>
                    <div class="user-mail">@email</div>
                </div>

            </div>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-icon" title="Çıkış yap">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>

        </div>

    </aside>

    <main class="content">

        <header class="topbar">

            <div class="assistant-select">

                <button type="button" class="assistant-button" id="assistantButton">
                    Nexa Assistant
                    <i class="bi bi-chevron-down ms-1"></i>
                </button>

                <div class="assistant-menu" id="assistantMenu">

                    <button type="button">
                        <i class="bi bi-stars me-2"></i>
                        Nexa Assistant
                    </button>

                    <button type="button">
                        <i class="bi bi-code-slash me-2"></i>
                        Code Assistant
                    </button>

                    <button type="button">
                        <i class="bi bi-mic me-2"></i>
                        Voice Assistant
                    </button>

                </div>

            </div>

            <div class="topbar-right">

                <button type="button" class="top-icon" id="themeButton" title="Tema değiştir">
                    <i class="bi bi-moon" id="themeIcon"></i>
                </button>

                <div class="profile-wrapper">

                    <button type="button" class="profile-button" id="profileButton">@initials</button>

                    <div class="profile-menu" id="profileMenu">

                        <div class="profile-menu-header">
                            <div class="profile-menu-name">@fullName</div>
                            <div class="profile-menu-mail">@email</div>
                        </div>

                        <button type="button" class="profile-menu-item">
                            <i class="bi bi-person"></i>
                            Profil
                        </button>

                        <button type="button" class="profile-menu-item">
                            <i class="bi bi-gear"></i>
                            Ayarlar
                        </button>

                        <button type="button" class="profile-menu-item" id="profileThemeButton">
                            <i class="bi bi-circle-half"></i>
                            Temayı değiştir
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="profile-menu-item logout">
                                <i class="bi bi-box-arrow-right"></i>
                                Çıkış yap
                            </button>
                        </form>

                    </div>

                </div>

            </div>

        </header>

        <section class="main-area">

            @if (selectedConversationId == null)
            {
                <div class="default-home">
                    <div class="default-home-inner">

                        <div class="home-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <h1>Sana nasıl yardımcı olabilirim?</h1>

                        <form asp-controller="Conversation" asp-action="Start" method="post" class="composer" id="startConversationForm">
                            @Html.AntiForgeryToken()

                            <textarea name="Content" id="messageInput" rows="1" placeholder="NexaAI'ye bir şey sor..." required></textarea>

                            <div class="composer-buttons">
                                <button type="button" class="composer-button" id="micButton" title="Sesli mesaj">
                                    <i class="bi bi-mic"></i>
                                </button>

                                <button type="submit" class="composer-button send-button" id="sendButton" title="Gönder">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            }
            else
            {
                @await Component.InvokeAsync("_ConversationDetailComponentPartial", new { conversationId = selectedConversationId.Value })
            }

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/default-ui.js" asp-append-version="true"></script>
<script src="~/js/chat.js" asp-append-version="true"></script>
<script src="~/js/speech.js" asp-append-version="true"></script>

</body>
</html>