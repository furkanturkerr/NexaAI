@using Markdig
@model NexaAI.WebUI.Dtos.ConversationDtos.ConversationDetailDto

@{
    var markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();
}

<div class="conversation-view">

    <div class="conversation-heading">
        <div class="conversation-heading-label">
            Sohbet
        </div>

        <h2 class="conversation-title">
            @Model.Title
        </h2>
    </div>

    <div class="chat-content" id="chatContent">

        <div class="messages"
             id="messages"
             data-conversation-id="@Model.Id">

            @foreach (var message in Model.Messages)
            {
                if (message.Role == 1)
                {
                    <div class="message user">
                        <div class="user-message-content">@message.Content</div>
                    </div>
                }
                else
                {
                    <div class="message ai">

                        <div class="ai-content">
                            @Html.Raw(Markdown.ToHtml(message.Content, markdownPipeline))
                        </div>

                        <button type="button"
                                class="tts-button"
                                title="Sesli dinle">
                            <i class="bi bi-volume-up"></i>
                        </button>

                    </div>
                }
            }

        </div>

        @if (!Model.Messages.Any())
        {
            <div class="empty-conversation"
                 id="emptyConversation">

                Bu sohbette henüz gösterilecek mesaj yok.

            </div>
        }

    </div>
    
    <div class="voice-status"
         id="voiceStatus"
         style="display: none;">
    </div>

    <div class="composer-area">

        <form asp-controller="Message"
              asp-action="Send"
              method="post"
              class="composer"
              id="messageForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ConversationId"
                   id="conversationId"
                   value="@Model.Id"/>

            <textarea name="Content"
                      id="messageInput"
                      rows="1"
                      placeholder="NexaAI'ye bir şey sor..."
                      required></textarea>

            <div class="composer-buttons">

                <button type="button"
                        class="composer-button"
                        id="micButton"
                        title="Sesli mesaj">
                    <i class="bi bi-mic"></i>
                </button>

                <button type="submit"
                        class="composer-button send-button"
                        id="sendButton"
                        title="Gönder">

                    <i class="bi bi-send-fill"></i>

                </button>

            </div>

        </form>

    </div>

</div>